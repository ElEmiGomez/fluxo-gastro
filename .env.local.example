# Configuración de Conexión a Supabase
# Obtén estos datos en: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# NOTA: Si dejas estas variables vacías o con valores por defecto,
# la aplicación activará automáticamente el motor de MOCK / Demo con persistencia local
# para que puedas probar todas las vistas y flujos al instante sin configuración previa.
